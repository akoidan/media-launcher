pkgname=media-launcher
pkgbase=media-launcher
pkgver=cb31997
pkgrel=1
releaser=akoidan
pkgdesc="Cross-platform tool that generates executable scripts to launch video files with external audio tracks and subtitles. Automatically resolves sidecar media and opens the video in the player of your choice. Designed for fast, repeatable multi-track playback."
url="https://github.com/${releaser}/media-launcher"
license=("MIT")
arch=('x86_64')

source=(
    "${pkgname}::https://github.com/${releaser}/${pkgname}/releases/download/${pkgver}/media-launcher.elf"
)

sha256sums=('8be4e9d60dad3a42c06ffe60e5601a51fa9f20c16760a81def785faa2ee247da')


package() {
  install -D -m755 "${srcdir}/media-launcher" "${pkgdir}/usr/bin/media-launcher"
}